# Local Supabase Edge Function values. Copy to `supabase/functions/.env`.
# Server-side only; never expose these through VITE_* variables.
# Hosted Supabase projects use project secrets instead of this local file.

# Supabase local runtime
SUPABASE_URL=http://127.0.0.1:45121
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SECRET_KEY=your-local-service-role-key

# PoE OAuth server secrets
POE_CLIENT_ID=poeparty
POE_CLIENT_SECRET=
POE_REDIRECT_URI=http://localhost:5173/auth/callback
# Exact comma-separated frontend return URLs accepted after the OAuth callback.
POE_ALLOWED_RETURN_URLS=http://localhost:5173/auth/callback
POE_CONTACT=support@poe-party.com
POE_PUBLIC_USER_AGENT=poe-party/1.0 (contact: support@poe-party.com) public-analysis
# AES-256-GCM token encryption. Each value in the JSON key ring must be an
# unpadded base64url encoding of exactly 32 random bytes (43 characters).
POE_TOKEN_ENCRYPTION_ACTIVE_KEY_ID=local-2026-07
POE_TOKEN_ENCRYPTION_KEYS={"local-2026-07":"REPLACE_WITH_43_CHARACTER_BASE64URL_KEY"}

# Stripe billing
STRIPE_SECRET_KEY=sk_test_...
# For local testing, use the whsec value printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
BILLING_ALLOWED_RETURN_ORIGINS=http://localhost:5173
BILLING_RETURN_ORIGIN=http://localhost:5173
# Optional temporary billing rollout gate. Leave unset to allow all signed-in users.
# Set to a comma-separated PoE account allowlist only while intentionally gating billing.
BILLING_ALLOWED_POE_ACCOUNTS=
STRIPE_ALLOW_PROMOTION_CODES=false
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

# Optimizer worker callback from Edge Functions
UPGRADE_ANALYZER_WORKER_URL=http://127.0.0.1:8788
UPGRADE_ANALYZER_WORKER_TOKEN=local-only-worker-token-0123456789abcdef
UPGRADE_ANALYZER_WORKER_NOTIFY_TIMEOUT_MS=1500
