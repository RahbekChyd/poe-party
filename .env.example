# Local Vite frontend values. Copy to `.env.local` for local Vite usage.
# Browser-readable values only; do not put server secrets here.

# Supabase (local CLI)
VITE_SUPABASE_URL=http://127.0.0.1:45121
VITE_SUPABASE_ANON_KEY=your-local-anon-key
VITE_SUPABASE_FUNCTIONS_KEY=your-local-functions-key

# PoE OAuth
VITE_POE_CLIENT_ID=
VITE_POE_REDIRECT_URI=http://localhost:5173/auth/callback

# Optional PoE2 creation gate for early or partial support.
# Comma-separated normalized account names such as AccountName#1234, or leave empty.
VITE_POE2_ALLOWED_ACCOUNT_NAMES=

# Enable session-cookie auth UI outside local dev when needed (for example staging)
VITE_ENABLE_COOKIE_AUTH=false

# Optional temporary billing rollout gate. Leave unset to show billing to all signed-in users.
# Set to a comma-separated PoE account allowlist only while intentionally gating billing.
VITE_BILLING_ALLOWED_POE_ACCOUNTS=
